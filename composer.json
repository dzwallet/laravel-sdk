{
    "name": "dzwallet/laravel-sdk",
    "description": "PHP / Laravel SDK for the DzWallet payment API (CIB and Edahabia card payments through SATIM, payment links and QR codes).",
    "keywords": [
        "dzwallet",
        "algeria",
        "satim",
        "cib",
        "edahabia",
        "payment",
        "laravel",
        "sdk"
    ],
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "illuminate/contracts": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "illuminate/support": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "DzWallet\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DzWallet\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "DzWallet\\DzWalletServiceProvider"
            ],
            "aliases": {
                "DzWallet": "DzWallet\\Facades\\DzWallet"
            }
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}